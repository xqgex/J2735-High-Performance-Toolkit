# Build directory (all build artifacts go here)
/build/

# Editor/IDE
.vscode/

# OS files
.DS_Store
Thumbs.db

# Compiled objects
*.o
*.obj
*.exe
*.a
*.so
*.dylib

# Cppcheck generated files
*.dump
*.ctu-info

# Python cache directories
__pycache__/
.hypothesis/
.mypy_cache/
.ruff_cache/

# Python test coverage data
.coverage
