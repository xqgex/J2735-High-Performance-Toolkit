/**
 * @brief Get pointer to nested '<field_name>' (<FieldType>) within <TypeName>.
 * @param buf Pointer to the <TypeName> encoding.
 * @return Pointer (uint8_t*) to the start of the nested <FieldType> encoding.
 * <if OPTIONAL> @pre J2735_<TYPE>_HAS_<FIELD_UPPER>(buf) must be true. </if OPTIONAL>
 * @note Use J2735_<FIELD_TYPE>_* macros to access fields within the nested structure.
 */
#define J2735_<TYPE>_GET_<FIELD_UPPER>_PTR(buf)                                                    \
  (&(buf)[J2735_OFF_<TYPE>_<FIELD_UPPER>(buf) >> 3U])
/* Note: For non-byte-aligned access, caller must use bit offset directly */
/* </for each nested composite field> */

/* </if has nested composite fields> */

