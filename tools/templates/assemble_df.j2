/**
 * @internal
 * @brief Number of bits for the count field of '<field_name>' SEQUENCE OF.
 *
 * Formula: ceil(log2(ub - lb + 1)) where SIZE(lb..ub).
 */
#define J2735_SEQOF_COUNT_BITS_<TYPE>_<FIELD_UPPER> <count_bits>U

/**
 * @brief Get element count for '<field_name>' SEQUENCE OF.
 * @param buf Pointer to the <TypeName> encoding.
 * @return Number of elements (range <lb>..<ub>).
 */
#define J2735_<TYPE>_<FIELD_UPPER>_COUNT(buf)                                                      \
  ((<lb>U) + (uint<N>_t)J2735_READ_BITS((buf), J2735_OFF_<TYPE>_<FIELD_UPPER>(buf),                \
                                        J2735_SEQOF_COUNT_BITS_<TYPE>_<FIELD_UPPER>))

/**
 * @brief Iterator for '<field_name>' SEQUENCE OF <ElementType>.
 */
typedef struct {
  uint8_t const *buf;      /**< Pointer to <TypeName> encoding */
  uint32_t bit_offset;     /**< Current bit offset within buf */
  uint16_t remaining;      /**< Elements remaining */
  uint16_t total;          /**< Total element count */
} j2735_<type>_<field>_iter_t;

/**
 * @brief Initialize iterator for '<field_name>' SEQUENCE OF.
 * @param buf  Pointer to the <TypeName> encoding.
 * @param iter Output: initialized iterator.
 * @return 0 on success, non-zero on error.
 */
static inline int j2735_<type>_<field>_begin(uint8_t const *const buf,
                                             j2735_<type>_<field>_iter_t *const iter) {
  <Add iterator initialization logic here>
  return 0;
}

/**
