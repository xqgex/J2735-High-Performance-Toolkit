{#-
  J2735 Data Frame Struct Template

  Generates a complete C struct definition for a SEQUENCE type, including:
  - Doxygen documentation with wire format table
  - Forward declaration (MISRA 8.4 compliant)
  - Struct typedef with raw_bytes array

  Context variables:
    - typedef: ASN1TypeDefinition for the SEQUENCE type with:
        - name: Original type name (e.g., "BSMcoreData")
        - uper_bit_width: Total bit-width of the SEQUENCE
    - sequence_variants: list[SequenceWireVariant] from get_sequence_variants()
    - opt_count: Number of OPTIONAL fields (for bitmap width)

  Filters used:
    - bytes_from_bits: Converts bits to bytes using ceiling division
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE

  Output format:
    /**
     * @struct J2735_BSMcoreData_t
     * @brief Container for BSMcoreData (37 bytes / 290 bits).
     * ...wire format table...
     */
    typedef struct J2735_BSMcoreData J2735_BSMcoreData_t;
    typedef struct J2735_BSMcoreData {
        uint8_t raw_bytes[J2735_SIZE_BSM_CORE_DATA];
    } J2735_BSMcoreData_t;
-#}
/**
 * @struct J2735_{{ typedef.name }}_t
 * @brief Container for {{ typedef.name }} ({{ typedef.uper_bit_width | bytes_from_bits }} bytes / {{ typedef.uper_bit_width }} bits).
 *
 * @par {{ typedef.name }} Wire Format (UPER):
{% include 'wire_format_sequence_section.j2' %}
 */
typedef struct J2735_{{ typedef.name }} J2735_{{ typedef.name }}_t; /* MISRA 8.4: Forward declaration */
typedef struct J2735_{{ typedef.name }} {
    uint8_t raw_bytes[J2735_SIZE_{{ typedef.name | screaming_snake }}];
} J2735_{{ typedef.name }}_t;
