{#-
  J2735 Has-Extension Macro Template

  Generates #define J2735_<SEQUENCE>_HAS_EXTENSION(buf) for extensible SEQUENCE types.
  Wraps the core J2735_INTERNAL_HAS_EXTENSION macro with a type-specific name.

  Context variables:
    - typedef: The full typedef object containing the metadata

  Filters used:
    - screaming_snake: CamelCase -> SCREAMING_SNAKE_CASE

  Output format:
    /**
     * @brief Check if PathPrediction has extension additions present.
     * ...
     */
    #define J2735_PATH_PREDICTION_HAS_EXTENSION(buf) J2735_INTERNAL_HAS_EXTENSION(buf)
-#}
{%- set typedef_name = typedef.name -%}
{%- set typedef_name_upper = typedef_name | screaming_snake -%}
/**
 * @brief Check if {{ typedef_name }} has extension additions present.
 * @param buf Pointer to the {{ typedef_name }} encoding.
 * @return 1 if extensions are present, 0 otherwise.
 */
#define J2735_{{ typedef_name_upper }}_HAS_EXTENSION(buf) J2735_INTERNAL_HAS_EXTENSION(buf)
