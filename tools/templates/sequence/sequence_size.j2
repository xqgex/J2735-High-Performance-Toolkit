{#-
  J2735 Size Function Template

  Generates static inline j2735_inline_<sequence>_size() for extensible SEQUENCE types.
  Calculates total size in bits, handling extended and non-extended cases.

  Context variables:
    - typedef: The full typedef object containing the metadata

  Filters used:
    - screaming_snake: CamelCase -> SCREAMING_SNAKE_CASE
    - snake_case: CamelCase -> snake_case

  Output format:
    static inline int j2735_inline_path_prediction_size(...) { ... }

  Dependencies:
    - J2735_INTERNAL_ROOT_SIZE_BITS_<SEQUENCE> (from root_size generator)
    - J2735_<SEQUENCE>_HAS_EXTENSION (from has_extension generator)
    - j2735_internal_inline_skip_extensions() (from J2735_macros.h)
-#}
{%- set typedef_name = typedef.name -%}
{%- set root_uper_bit_width = typedef.constraint.root_uper_bit_width -%}
{%- set typedef_name_lower = typedef_name | snake_case -%}
{%- set typedef_name_upper = typedef_name | screaming_snake -%}
/**
 * @brief Calculate total size in bits of a {{ typedef_name }} encoding.
 *
 * For non-extended messages, returns the fixed root size ({{ root_uper_bit_width }} bits).
 * For extended messages, parses and skips extension data.
 *
 * @param buf           Pointer to the {{ typedef_name }} encoding.
 * @param out_size_bits Output: total size in bits.
 * @return 0 on success, non-zero on parsing error.
 */
static inline int j2735_inline_{{ typedef_name_lower }}_size(uint8_t const *const buf, uint32_t *const out_size_bits) {
  int result = 0;

  /* cppcheck-suppress misra-c2012-11.3 ; Zero-copy architecture requires packed-struct cast */
  /* cppcheck-suppress misra-c2012-17.3 ; cppcheck false positive: v is struct member, not function */
  /* cppcheck-suppress misra-config ; cppcheck cannot resolve struct member v through macro expansion */
  if (J2735_{{ typedef_name_upper }}_HAS_EXTENSION(buf) == 0U) {
    *out_size_bits = J2735_INTERNAL_ROOT_SIZE_BITS_{{ typedef_name_upper }};
    result = 0;
  } else {
    /* Extensions present - parse them to find total size */
    uint32_t ext_bits = 0U;
    int const parse_result = j2735_internal_inline_skip_extensions(buf, J2735_INTERNAL_ROOT_SIZE_BITS_{{ typedef_name_upper }}, &ext_bits);
    if (0 != parse_result) {
      *out_size_bits = 0U;
      result = parse_result;
    } else {
      *out_size_bits = J2735_INTERNAL_ROOT_SIZE_BITS_{{ typedef_name_upper }} + ext_bits;
      result = 0;
    }
  }
  return result;
}
