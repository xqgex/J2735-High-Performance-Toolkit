{#-
  J2735 Sequence Accessor Macros Template

  Generates #define J2735_<SEQUENCE>_GET_<FIELD>(buf) macros for a SEQUENCE type.
  These macros provide O(1) field access using the offset and bit-width constants.
  Uses J2735_INTERNAL_OFF_<SEQUENCE>_<FIELD>(buf) which handles both fixed and dynamic offsets.

  Context variables:
  - typedef: The full typedef object containing the metadata

  Filters used:
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE
    - c_type: Maps (bits, is_signed) to C type string (e.g., "uint8_t", "int32_t")

  Output format (unsigned):
    #define J2735_BSM_CORE_DATA_GET_MSG_CNT(buf) \
      ((uint8_t)J2735_READ_BITS((buf), J2735_INTERNAL_OFF_BSM_CORE_DATA_MSG_CNT(buf), J2735_BW_MSG_COUNT))

  Output format (signed):
    #define J2735_BSM_CORE_DATA_GET_LAT(buf) \
      J2735_INTERNAL_SIGN_EXTEND(J2735_READ_BITS((buf), J2735_INTERNAL_OFF_BSM_CORE_DATA_LAT(buf), J2735_BW_LATITUDE), J2735_BW_LATITUDE, int32_t)
-#}
{%- set typedef_name = typedef.name -%}
{%- set typedef_name_upper = typedef_name | screaming_snake -%}
{%- for field in typedef.constraint.fields -%}
{#-   Determine if this field is signed (INTEGER with min_value < 0) -#}
{%-   set bits = field.type.uper_bit_width -%}
{%-   set field_name = field.name | screaming_snake -%}
{%-   set is_signed = field.type.min_value is defined and field.type.min_value < 0 -%}
{%-   set field_type_name = field.type_name | screaming_snake -%}
{%-   set return_type = bits | c_type(is_signed) -%}
{%-   set signedness = 'signed' if is_signed else 'unsigned' -%}
{%-   set min_val = field.type.min_value if field.type.min_value is defined else 0 -%}
{%-   set max_val = field.type.max_value if field.type.max_value is defined else (2**bits - 1) -%}
/**
 * @brief Get '{{ field.name }}' ({{ field.type_name }}, {{ signedness }} {{ bits }} bits).
 * @param[in] buf Pointer to the {{ typedef_name }} encoding.
 * @return {{ field.type_name }} value ({{ return_type }}, range {{ min_val }}..{{ max_val }}).
{%    if field.is_optional %}
 * @pre J2735_{{ typedef_name_upper }}_HAS_{{ field_name }}(buf) must be true.
{%    endif %}
 */
{%    if is_signed -%}
#define J2735_{{ typedef_name_upper }}_GET_{{ field_name }}(buf) \
  J2735_INTERNAL_SIGN_EXTEND(J2735_READ_BITS((buf), J2735_INTERNAL_OFF_{{ typedef_name_upper }}_{{ field_name }}(buf), J2735_BW_{{ field_type_name }}), J2735_BW_{{ field_type_name }}, {{ return_type }})
{%-   else -%}
#define J2735_{{ typedef_name_upper }}_GET_{{ field_name }}(buf) \
  (({{ return_type }})J2735_READ_BITS((buf), J2735_INTERNAL_OFF_{{ typedef_name_upper }}_{{ field_name }}(buf), J2735_BW_{{ field_type_name }}))
{%-   endif -%}
{{ "" }}
{{ "" }}
{%  endfor -%}