{#-
  J2735 Byte Size Constants Template

  Generates #define J2735_SIZE_* constants for all Data Elements with fixed bit-widths.
  SIZE = ceil(bit_width / 8) = (bit_width + 7) / 8
  These constants are used for buffer allocation in zero-copy container structs.

  Context variables:
    - types: Iterable of ASN1TypeDefinition objects with:
        - name: Original type name (e.g., "BSMcoreData")
        - uper_bit_width: Fixed bit-width (int)
    - spec_version: Version string (e.g., "J2735_202409")

  Filters used:
    - bytes_from_bits: Converts bits to bytes using ceiling division
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE

  Output format:
    #define J2735_SIZE_BSM_CORE_DATA 37U /* 290 bits -> 37 bytes */
-#}
{#- Banner line width: 100 chars total, content area is 92 chars -#}
{%- set W = 92 -%}
{%- set line1 = "J2735 BYTE SIZE CONSTANTS (Spec: J2735_" ~ spec_version ~ ")" -%}
{%- set line2 = "Auto-generated: " ~ types|length ~ " types with fixed sizes" -%}
/* ============================================================================================== */
/*  {{ "%-*s"|format(W, line1) }}  */
/*  Used for buffer allocation: SIZE = ceil(bit_width / 8)                                        */
/*  {{ "%-*s"|format(W, line2) }}  */
/* ============================================================================================== */
{%  for t in types -%}
{%-   set t_uper_bytes = t.uper_bit_width | bytes_from_bits -%}
#define J2735_SIZE_{{ t.name | screaming_snake }} {{ t_uper_bytes }}U /* {{ t.uper_bit_width }} bits -> {{ t_uper_bytes }} bytes */
{%  endfor %}
