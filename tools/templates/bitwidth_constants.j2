{#-
  J2735 Bit-Width Constants Template

  Generates #define J2735_BW_* constants for all Data Elements with fixed bit-widths.
  These constants enable O(1) bit-stream navigation in the zero-copy parser.

  Context variables:
    - types: Iterable of ASN1TypeDefinition objects with:
        - name: Original type name (e.g., "MsgCount")
        - type_class: ASN1TypeClass enum value
        - uper_bit_width: Fixed bit-width (int)
        - constraint: The parsed constraint object (type varies by type_class)
    - spec_version: Version string (e.g., "J2735_202409")
    - variable_count: Number of types with variable bit-widths

  Filters used:
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE

  Output format:
    #define J2735_BW_MSG_COUNT 7U /* MsgCount: INTEGER (0..127) */
-#}
{#- Banner line width: 100 chars total, content area is 92 chars (between "/*  " and "  */") -#}
{%- set W = 92 -%}
{%- set line1 = "J2735 BIT-WIDTH CONSTANTS (Spec: J2735_" ~ spec_version ~ ")" -%}
{%- set line2 = "Auto-generated: " ~ types|length ~ " types with fixed bit-widths (" ~ variable_count ~ " variable)" -%}
/* ============================================================================================== */
/*  {{ "%-*s"|format(W, line1) }}  */
/*  Required for O(1) bit-stream navigation.                                                      */
/*  {{ "%-*s"|format(W, line2) }}  */
/*  Constraint: All bit-widths must satisfy 1 <= width <= 56 for use with J2735_READ_BITS.        */
/* ============================================================================================== */
{%  for t in types %}
{#-   Build the comment based on type_class -#}
{%-   if t.type_class.name == "BIT_STRING" -%}
{#-     BIT STRING: Show SIZE -#}
{%-     set comment = t.name ~ ": BIT STRING (SIZE(" ~ t.constraint.root_size ~ "))" -%}
{%-   elif t.type_class.name == "BOOLEAN" -%}
{#-     BOOLEAN: Simple -#}
{%-     set comment = t.name ~ ": BOOLEAN" -%}
{%-   elif t.type_class.name == "CHOICE" -%}
{#-     CHOICE: Show alternative count -#}
{%-     set comment = t.name ~ ": CHOICE (" ~ t.constraint.alternative_count ~ " alternatives)" -%}
{%-   elif t.type_class.name == "ENUMERATED" -%}
{#-     ENUMERATED: Show value count -#}
{%-     set comment = t.name ~ ": ENUMERATED (" ~ t.constraint.value_count ~ " values)" -%}
{%-   elif t.type_class.name == "IA5_STRING" -%}
{#-     IA5String: Show SIZE -#}
{%-     if t.constraint.is_fixed_size -%}
{%-       set comment = t.name ~ ": IA5String (SIZE(" ~ t.constraint.min_size ~ "))" -%}
{%-     else -%}
{%-       set comment = t.name ~ ": IA5String (SIZE(" ~ t.constraint.min_size ~ ".." ~ t.constraint.max_size ~ "))" -%}
{%-     endif -%}
{%-   elif t.type_class.name == "INTEGER" -%}
{#-     INTEGER: Show range (min..max) -#}
{%-     set comment = t.name ~ ": INTEGER (" ~ t.constraint.min_value ~ ".." ~ t.constraint.max_value ~ ")" -%}
{%-   elif t.type_class.name == "OCTET_STRING" -%}
{#-     OCTET STRING: Show SIZE -#}
{%-     if t.constraint.is_fixed_size -%}
{%-       set comment = t.name ~ ": OCTET STRING (SIZE(" ~ t.constraint.min_size ~ "))" -%}
{%-     else -%}
{%-       set comment = t.name ~ ": OCTET STRING (SIZE(" ~ t.constraint.min_size ~ ".." ~ t.constraint.max_size ~ "))" -%}
{%-     endif -%}
{%-   elif t.type_class.name == "SEQUENCE" -%}
{#-     SEQUENCE: Show field count and total -#}
{%-     set comment = t.name ~ ": SEQUENCE (" ~ t.constraint.fields|length ~ " fields)" -%}
{%-   else -%}
{#-     Fallback for unknown types -#}
{%-     set comment = t.name -%}
{%- endif -%}
#define J2735_BW_{{ t.name | screaming_snake }} {{ t.uper_bit_width }}U /* {{ comment }} */
{% endfor %}
