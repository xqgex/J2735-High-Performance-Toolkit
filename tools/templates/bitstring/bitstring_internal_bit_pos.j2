{#-
  BIT STRING Internal Bit Position Constants Template

  Generates C #define constants for ASN.1 BIT STRING named bit positions.
  Pattern: J2735_INTERNAL_BIT_{TYPE}_{FLAG} {INDEX}U

  Context variables:
    - type_name: Type name (e.g., "VehicleEventFlags")
    - named_bits: Mapping from name to index

  Filters used:
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE

  Output format:
    #define J2735_INTERNAL_BIT_VEHICLE_EVENT_FLAGS_EVENT_HAZARD_LIGHTS 0U
    #define J2735_INTERNAL_BIT_VEHICLE_EVENT_FLAGS_EVENT_JACK_KNIFE    13U
-#}
{%- set seq_upper = type_name | screaming_snake %}
{%  for name, index in named_bits.items() %}
#define J2735_INTERNAL_BIT_{{ seq_upper }}_{{ name | screaming_snake }} {{ index }}U
{%  endfor %}
