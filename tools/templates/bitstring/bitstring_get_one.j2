{#-
Template: bitstring_get_one.j2
Purpose: Generate public C macros for accessing individual flags from a BIT STRING.

Template Context (from generator):
  - typedef: The full typedef object containing the metadata

Example output:
    /**
     * @brief Get eventHazardLights flag (ASN.1 bit 0).
     * ...
     */
    #define J2735_VEHICLE_EVENT_FLAGS_GET_EVENT_HAZARD_LIGHTS(buf) \
      J2735_INTERNAL_GET_ONE_VEHICLE_EVENT_FLAGS(J2735_INTERNAL_RAW_READ_VEHICLE_EVENT_FLAGS(buf), \
        J2735_INTERNAL_BIT_VEHICLE_EVENT_FLAGS_EVENT_HAZARD_LIGHTS)
-#}
{%- set is_extensible = typedef.constraint.is_extensible -%}
{%- set named_bits = typedef.constraint.named_bits -%}
{%- set root_size = typedef.constraint.root_size -%}
{%- set typedef_name = typedef.name -%}
{%- set typedef_name_upper = typedef_name | screaming_snake -%}
{%- for name, index in named_bits.items() %}
{%    set named_bit_upper = name | screaming_snake %}
{%    set is_extension = is_extensible and index >= root_size %}
{%    if is_extension %}
/**
 * @brief Get {{ name }} flag (ASN.1 bit {{ index }}, extended form only).
 *
 * This flag is only present in extended-form {{ typedef_name }} messages.
 *
 * @param[in] buf Pointer to {{ typedef_name }} UPER encoding (const uint8_t*).
 * @pre @p buf must point to valid encoding with +7 byte padding.
 * @pre Caller should verify J2735_{{ typedef_name_upper }}_IS_EXTENDED(buf) returns true.
 * @return 0 or 1.
 * @warning Returns garbage (0 or 1) for non-extended messages. Always check IS_EXTENDED first.
 */
{%    else %}
/**
 * @brief Get {{ name }} flag (ASN.1 bit {{ index }}).
 * @param[in] buf Pointer to {{ typedef_name }} UPER encoding (const uint8_t*).
 * @pre @p buf must point to valid encoding with +7 byte padding.
 * @return 0 or 1.
 */
{%    endif %}
#define J2735_{{ typedef_name_upper }}_GET_{{ named_bit_upper }}(buf) \
  J2735_INTERNAL_GET_ONE_{{ typedef_name_upper }}(J2735_INTERNAL_RAW_READ_{{ typedef_name_upper }}(buf), \
    J2735_INTERNAL_BIT_{{ typedef_name_upper }}_{{ named_bit_upper }})

{%  endfor %}
