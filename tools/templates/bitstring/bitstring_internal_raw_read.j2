{#-
  BIT STRING Internal Raw Read Template

  Generates C macro for reading raw bits from buffer.
  Pattern: J2735_INTERNAL_RAW_READ_{TYPE}(buf)

  Context variables:
    - typedef: The full typedef object containing the metadata

  Filters used:
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE
    - bytes_from_bits: Converts bits to bytes (ceiling division)

  Output format:
    /** @internal @brief Read N bits... */
    #define J2735_INTERNAL_RAW_READ_VEHICLE_EVENT_FLAGS(buf) J2735_READ_BITS((buf), 0U, 22U)
-#}
{%- set is_extensible = typedef.constraint.is_extensible -%}
{%- set read_bits = typedef.constraint.read_bits -%}
{%- set typedef_name = typedef.name -%}
{%- set typedef_name_upper = typedef_name | screaming_snake -%}
{%- set read_bytes = read_bits | bytes_from_bits -%}
/**
 * @internal
 * @brief Read {{ read_bits }} bits from buffer for {{ typedef_name }}.
 *
 * This is the ONLY macro that performs I/O (calls J2735_READ_BITS) for {{ typedef_name }}.
 * All other macros operate purely on the {{ read_bits }}-bit value returned by this macro.
 *
 * @param[in] buf Pointer to UPER-encoded {{ typedef_name }} (const uint8_t*).
 * @pre @p buf must point to at least {{ read_bytes }} bytes of readable memory.
 * @pre Buffer should include +7 bytes padding beyond data for J2735_READ_BITS safety.
 * @pre @p buf must be aligned to the start of the {{ typedef_name }} encoding.
{% if is_extensible %}
 * @return {{ read_bits }}-bit value as uint64_t with wire bits left-justified:
 *         - Bit {{ read_bits - 1 }}: Extension marker (0=root, 1=extended)
 *         - Bits {{ read_bits - 2 }}..0: Payload (format depends on extension state)
{% else %}
 * @return {{ read_bits }}-bit value as uint64_t with wire bits left-justified.
{% endif %}
 * @note Internal use only. Not part of the public API.
 */
#define J2735_INTERNAL_RAW_READ_{{ typedef_name_upper }}(buf) \
{% if is_extensible %}
  J2735_READ_BITS((buf), 0U, J2735_INTERNAL_MAX_WIRE_BITS_{{ typedef_name_upper }})
{% else %}
  J2735_READ_BITS((buf), 0U, J2735_BW_{{ typedef_name_upper }})
{% endif %}
