{#-
  BIT STRING Public Is-Extended Macro Template

  Generates public C macro for checking if a BIT STRING is in extended form.

  Context variables:
    - typedef: The full typedef object containing the metadata

  Output format:
    /**
     * @brief Check if VehicleEventFlags is in extended form.
     * ...
     */
    #define J2735_VEHICLE_EVENT_FLAGS_IS_EXTENDED(buf) \
      J2735_INTERNAL_IS_EXTENSION_VEHICLE_EVENT_FLAGS(J2735_INTERNAL_RAW_READ_VEHICLE_EVENT_FLAGS(buf))
-#}
{%- set ext_bits = typedef.constraint.ext_bits -%}
{%- set root_size = typedef.constraint.root_size -%}
{%- set typedef_name = typedef.name -%}
{%- set typedef_name_upper = typedef_name | screaming_snake -%}
{%  if typedef.constraint.is_extensible %}
/**
 * @brief Check if {{ typedef_name }} is in extended form.
 *
 * Extended form includes {{ ext_bits }} flags (bits 0-{{ ext_bits - 1 }}).
 * Root form has only {{ root_size }} flags (bits 0-{{ root_size - 1 }}).
 *
 * @param[in] buf Pointer to the start of the {{ typedef_name }} UPER encoding (const uint8_t*).
 * @pre @p buf must point to valid {{ typedef_name }} encoding with +7 byte padding.
 * @return Non-zero (true) if extended ({{ ext_bits }} flags), zero (false) if root ({{ root_size }} flags).
 */
#define J2735_{{ typedef_name_upper }}_IS_EXTENDED(buf) \
  J2735_INTERNAL_IS_EXTENSION_{{ typedef_name_upper }}(J2735_INTERNAL_RAW_READ_{{ typedef_name_upper }}(buf))
{%  else %}
/**
 * @brief Check if {{ typedef_name }} is in extended form.
 *
 * {{ typedef_name }} is a fixed-size BIT STRING with {{ root_size }} bits.
 * It does not have an extension marker, so this always returns 0 (false).
 *
 * @param[in] buf Pointer to the start of the {{ typedef_name }} UPER encoding (const uint8_t*).
 * @return Always 0 (false) - this type is not extensible.
 */
#define J2735_{{ typedef_name_upper }}_IS_EXTENDED(buf) ((void)(buf), 0)
{%  endif %}
