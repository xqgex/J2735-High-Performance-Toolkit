{#-
  BIT STRING Internal Extension Check Template

  Generates C macro for checking extension bit from pre-read raw value.
  Pattern: J2735_INTERNAL_IS_EXTENSION_{TYPE}(raw)

  Context variables:
    - type_name: Type name (e.g., "VehicleEventFlags")
    - is_extensible: Whether the BIT STRING is extensible
    - read_bits: Total bits read from buffer
    - root_size: Number of bits in root form
    - ext_bits: Number of bits in extended form

  Filters used:
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE

  Output format:
    #define J2735_INTERNAL_IS_EXTENSION_VEHICLE_EVENT_FLAGS(raw22) (((raw22) >> 21U) != 0U)
-#}
{%- set ext_bit_pos = read_bits - 1 -%}
{%- set seq_upper = type_name | screaming_snake -%}
{% if is_extensible %}
/**
 * @internal
 * @brief Check extension bit from pre-read {{ read_bits }}-bit raw value.
 *
 * The extension bit is at position {{ ext_bit_pos }} (MSB of the {{ read_bits }}-bit read):
 * - 0 = Root form: {{ root_size }} flag bits follow immediately after extension bit
 * - 1 = Extended form: 7-bit nsnnwn (value={{ ext_bits }}) followed by {{ ext_bits }} flag bits
 *
 * @param[in] raw{{ read_bits }} Value previously returned by J2735_INTERNAL_RAW_READ_{{ seq_upper }}().
 * @return Non-zero (true) if extended form, zero (false) if root form.
 * @note Internal use only. Use J2735_{{ seq_upper }}_IS_EXTENDED() for public API.
 */
#define J2735_INTERNAL_IS_EXTENSION_{{ seq_upper }}(raw{{ read_bits }}) \
  (((raw{{ read_bits }}) >> (J2735_INTERNAL_MAX_WIRE_BITS_{{ seq_upper }} - 1U)) != 0U)
{% else %}
/**
 * @internal
 * @brief Extension check for non-extensible {{ type_name }}.
 *
 * This type is not extensible, so always returns false (0).
 *
 * @param[in] raw{{ read_bits }} Value previously returned by J2735_INTERNAL_RAW_READ_{{ seq_upper }}().
 * @return Always 0 (not extended).
 * @note Internal use only.
 */
#define J2735_INTERNAL_IS_EXTENSION_{{ seq_upper }}(raw{{ read_bits }}) (0U)
{% endif %}
