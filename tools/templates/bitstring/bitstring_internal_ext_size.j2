{#-
  BIT STRING Internal Extended Size Constants Template

  Generates C #define constants for ASN.1 BIT STRING extended size.
  Pattern: J2735_INTERNAL_EXT_SIZE_{TYPE} {EXT_SIZE}U

  Context variables:
    - typedef: The full typedef object containing the metadata

  Filters used:
    - screaming_snake: Converts camelCase to SCREAMING_SNAKE_CASE

  Output format:
    /** @internal @brief Extended size of... */
    #define J2735_INTERNAL_EXT_SIZE_VEHICLE_EVENT_FLAGS 14U
-#}
{%- set ext_bits = typedef.constraint.ext_bits -%}
{%- set typedef_name = typedef.name -%}
{%- set typedef_name_upper = typedef_name | screaming_snake -%}
/**
 * @internal
 * @brief Extended size of {{ typedef_name }} in bits.
 */
#define J2735_INTERNAL_EXT_SIZE_{{ typedef_name_upper }} {{ ext_bits }}U
