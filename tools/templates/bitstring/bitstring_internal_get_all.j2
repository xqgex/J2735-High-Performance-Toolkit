{#-
  BIT STRING Internal Get-All Macro Template

  Generates C macro for extracting all flag bits from pre-read raw value.

  Context variables:
    - typedef: The full typedef object containing the metadata

  Output format:
    /**
     * @internal
     * @brief Extract all flag bits from pre-read 22-bit raw value.
     * ...
     */
    #define J2735_INTERNAL_GET_ALL_VEHICLE_EVENT_FLAGS(raw22) \
      (J2735_INTERNAL_IS_EXTENSION_VEHICLE_EVENT_FLAGS(raw22) \
           ? ((uint16_t)((raw22) & 0x3FFFU)) \
           : ((uint16_t)(((raw22) >> 8U) & 0x1FFFU)))
-#}
{%- set ext_bits = typedef.constraint.ext_bits -%}
{%- set read_bits = typedef.constraint.read_bits -%}
{%- set root_size = typedef.constraint.root_size -%}
{%- set typedef_name = typedef.name -%}
{%- set typedef_name_upper = typedef.name  | screaming_snake -%}
{%- set ext_mask = (2 ** ext_bits) - 1 -%}{#- Mask for extended bits (e.g., 0x3FFF) -#}
{%- set root_shift = read_bits - 1 - root_size -%}{#- Right shift for root extraction (e.g., 8) -#}
{%- set root_mask = (2 ** root_size) - 1 -%}{#- Mask for root bits (e.g., 0x1FFF) -#}
{%- set return_type = ext_bits | c_type -%}
{%- set hex_digits = {"uint8_t": 2, "uint16_t": 4, "uint32_t": 8, "uint64_t": 16}[return_type] -%}
{%- set hex_fmt = "%0" ~ hex_digits|string ~ "X" -%}
{%- set hex_zero = "0" * hex_digits -%}
{%  if typedef.constraint.is_extensible %}
/**
 * @internal
 * @brief Extract all flag bits from pre-read {{ read_bits }}-bit raw value.
 *
 * Bit layout depends on extension state:
 *
 * Non-extended (bit {{ read_bits - 1 }} = 0):
 *   raw{{ read_bits }}: [0][F0][F1]...[F{{ root_size - 1 }}][garbage:{{ root_shift }}]
 *           {{ "%2d" | format(read_bits - 1) }} {{ "%2d" | format(read_bits - 2) }}  {{ "%2d" | format(read_bits - 3) }}     {{ "%2d" | format(root_shift) }}    {{ "%2d" | format(root_shift - 1) }}..0
 *   Extract: (raw{{ read_bits }} >> {{ root_shift }}) & 0x{{ "%X" | format(root_mask) }} -> {{ root_size }} bits
 *
 * Extended (bit {{ read_bits - 1 }} = 1):
 *   raw{{ read_bits }}: [1][nsnnwn:7][F0][F1]...[F{{ ext_bits - 1 }}]
 *           {{ "%2d" | format(read_bits - 1) }}  {{ "%2d" | format(read_bits - 2) }}..{{ "%2d" | format(ext_bits) }}   {{ "%2d" | format(ext_bits - 1) }}  {{ "%2d" | format(ext_bits - 2) }}      0
 *   Extract: raw{{ read_bits }} & 0x{{ "%X" | format(ext_mask) }} -> {{ ext_bits }} bits
 *
 * @param[in] raw{{ read_bits }} Value previously returned by J2735_INTERNAL_RAW_READ_{{ typedef_name_upper }}().
 * @return Right-aligned flag bits as {{ return_type }}:
 *         - {{ root_size }} significant bits (0x{{ hex_zero }}-0x{{ hex_fmt | format(root_mask) }}) if non-extended
 *         - {{ ext_bits }} significant bits (0x{{ hex_zero }}-0x{{ hex_fmt | format(ext_mask) }}) if extended
 * @note Uses 1ULL for bit shifts to prevent undefined behavior if size >= 32 bits.
 *       The compiler optimizes the truncation to {{ return_type }}.
 * @note Internal use only. Use J2735_{{ typedef_name_upper }}_GET() for public API.
 */
#define J2735_INTERNAL_GET_ALL_{{ typedef_name_upper }}(raw{{ read_bits }}) \
  (J2735_INTERNAL_IS_EXTENSION_{{ typedef_name_upper }}(raw{{ read_bits }}) \
    ? /* Extended: low {{ ext_bits }} bits */ \
    (({{ return_type }})((raw{{ read_bits }}) & ((1ULL << J2735_INTERNAL_EXT_SIZE_{{ typedef_name_upper }}) - 1ULL))) \
    : /* Non-ext: bits {{ read_bits - 2 }}..{{ root_shift }} = {{ root_size }} bits */ \
    (({{ return_type }})(((raw{{ read_bits }}) >> (J2735_INTERNAL_MAX_WIRE_BITS_{{ typedef_name_upper }} - 1U - J2735_INTERNAL_ROOT_SIZE_{{ typedef_name_upper }})) \
                         & ((1ULL << J2735_INTERNAL_ROOT_SIZE_{{ typedef_name_upper }}) - 1ULL))))
{%  else %}
/**
 * @internal
 * @brief Extract all flag bits from pre-read {{ read_bits }}-bit raw value.
 *
 * @param[in] raw{{ read_bits }} Value previously returned by J2735_INTERNAL_RAW_READ_{{ typedef_name_upper }}().
 * @return Right-aligned flag bits as {{ return_type }}:
 *         - {{ root_size }} significant bits (0x{{ hex_zero }}-0x{{ hex_fmt | format(root_mask) }})
 * @note Internal use only. Use J2735_{{ typedef_name_upper }}_GET() for public API.
 */
#define J2735_INTERNAL_GET_ALL_{{ typedef_name_upper }}(raw{{ read_bits }}) \
  (({{ return_type }})((raw{{ read_bits }}) & 0x{{ "%X" | format(root_mask) }}U))
{%  endif %}
