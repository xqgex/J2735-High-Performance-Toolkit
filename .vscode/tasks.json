{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build All Tests",
      "type": "shell",
      "command": "make",
      "args": [
        "all"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "make",
      "args": [
        "test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "dependsOn": [
        "Build All Tests"
      ]
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "make",
      "args": [
        "clean"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Static Analysis (cppcheck)",
      "type": "shell",
      "command": "make",
      "args": [
        "check"
      ],
      "problemMatcher": {
        "owner": "cppcheck",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\[(.*?):(\\d+)\\]:\\s+\\((.*?)\\)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Static Analysis (clang-tidy)",
      "type": "shell",
      "command": "make",
      "args": [
        "tidy"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Format Code",
      "type": "shell",
      "command": "make",
      "args": [
        "format"
      ],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Sanitize (ASan + UBSan)",
      "type": "shell",
      "command": "make",
      "args": [
        "sanitize"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Valgrind Memory Check",
      "type": "shell",
      "command": "make",
      "args": [
        "valgrind"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Full Quality Check",
      "dependsOn": [
        "Clean Build",
        "Run All Tests",
        "Static Analysis (cppcheck)",
        "Sanitize (ASan + UBSan)",
        "Valgrind Memory Check"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}